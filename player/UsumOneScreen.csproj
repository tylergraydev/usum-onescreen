<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10 and 11, so players need no runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>UsumOneScreen</AssemblyName>
    <RootNamespace>UsumOneScreen</RootNamespace>
    <Version>0.1.1</Version>
    <Product>USUM One Screen</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="shaders\post-process.glsl" LogicalName="UsumOneScreen.PostProcess" />
    <EmbeddedResource Include="cheats\*.txt" LogicalName="UsumOneScreen.Cheats.%(Filename).txt" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="..\usum-onescreen.3gx" LogicalName="UsumOneScreen.Plugin" Condition="Exists('..\usum-onescreen.3gx')" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
